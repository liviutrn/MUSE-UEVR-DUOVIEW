+bool D3D12Component::mono_consumers_retired() {
+    const auto retired = [](d3d12::CommandContext& c) {
+        std::scoped_lock lock{c.mtx};
+        if (!c.waiting_for_fence) { return true; }
+        if (!c.fence) { return false; }
+        const auto value = c.fence->GetCompletedValue();
+        return value != UINT64_MAX && value >= c.fence_value;
+    };
+    for (auto& c : m_generic_commands) { if (!retired(c)) { return false; } }
+    for (auto& c : m_game_tex_commands) { if (!retired(c)) { return false; } }
+    for (auto& t : m_backbuffer_textures) { if (t && !retired(t->commands)) { return false; } }
+    for (auto& t : m_2d_screen_tex) { if (!retired(t.commands)) { return false; } }
+    if (!retired(m_backbuffer_copy.commands) || !retired(m_game_ui_tex.commands) || !retired(m_game_tex.commands) || !retired(m_scene_capture_tex.commands)) { return false; }
+    std::scoped_lock lock{m_openxr.mtx};
+    for (auto& [index, context] : m_openxr.contexts) {
+        if (context.num_textures_acquired) { return false; }
+        for (auto& t : context.texture_contexts) { if (!retired(t->commands)) { return false; } }
+    }
+    return true;
+}
